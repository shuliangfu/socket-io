{
  "name": "@dreamer/socket-io",
  "version": "1.2.0",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./types": "./src/types.ts",
    "./client": "./src/client/mod.ts",
    "./client/types": "./src/client/types.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/**/*.json",
      "LICENSE",
      "NOTICE",
      "README.md"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/test/**",
      "**/tests/**",
      "**/examples/**"
    ]
  },
  "lint": {
    "include": [
      "src/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "tasks": {
    "test": "deno test --allow-all tests/*.test.ts",
    "test:node": "tsx --tsconfig tsconfig.json --test --test-force-exit tests/*.test.ts",
    "check": "deno check src/mod.ts src/client/mod.ts",
    "publish": "deno publish"
  },
  "imports": {
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.1.2",
    "@dreamer/test": "jsr:@dreamer/test@^1.2.3",
    "@dreamer/logger": "jsr:@dreamer/logger@^1.1.0",
    "@dreamer/crypto": "jsr:@dreamer/crypto@^1.1.0",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.2.2",
    "mongodb": "npm:mongodb@7.0.0",
    "redis": "npm:redis@5.10.0"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": 0
}
