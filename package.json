{
  "name": "@dreamer/socket-io",
  "version": "1.2.1",
  "description": "Socket.IO server and client for Deno/Bun/Node.js 22+.",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./types": "./src/types.ts",
    "./client": "./src/client/mod.ts",
    "./client/types": "./src/client/types.ts"
  },
  "scripts": {
    "test": "bun test tests/",
    "test:node": "tsx --tsconfig tsconfig.json --test --test-force-exit tests/*.test.ts",
    "check": "deno check src/mod.ts src/client/mod.ts"
  },
  "dependencies": {
    "@dreamer/crypto": "npm:@jsr/dreamer__crypto@^1.1.0",
    "@dreamer/i18n": "npm:@jsr/dreamer__i18n@^1.1.2",
    "@dreamer/logger": "npm:@jsr/dreamer__logger@^1.1.0",
    "@dreamer/runtime-adapter": "npm:@jsr/dreamer__runtime-adapter@^1.2.2",
    "mongodb": "7.0.0",
    "redis": "5.10.0"
  },
  "devDependencies": {
    "@dreamer/test": "npm:@jsr/dreamer__test@^1.2.3",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": ["socket.io", "websocket", "dreamer"]
}
